{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "knppy/ui",
    "description": "Knppy UI is a robust Shadcn/ui port for Laravel applications.",
    "keywords": [
        "laravel",
        "knppy",
        "ui"
    ],
    "homepage": "https://github.com/knppy/ui",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Beers",
            "email": "michael@michaelbeers.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "gehrisandro/tailwind-merge-php": "^1.2",
        "illuminate/support": "^12.0||^13.0",
        "mallardduck/blade-lucide-icons": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pao": "^1.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.6||^5.0",
        "pestphp/pest-plugin-laravel": "^4.1||^5.0",
        "pestphp/pest-plugin-type-coverage": "^4.0||^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Knppy\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Knppy\\Ui\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "prepare": [
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "build": [
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench ui:install --force --baseColor=neutral",
            "@php vendor/bin/testbench cache:clear --ansi",
            "npx concurrently -c \"#3b82f6,#10b981\" \"php vendor/bin/testbench serve --ansi\" \"npm run dev\" --names=server,vite --kill-others"
        ],
        "lint": [
            "vendor/bin/pint --parallel --blade"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse"
        ],
        "test:types": [
            "vendor/bin/pest --min=100"
        ],
        "test:unit": [
            "vendor/bin/pest --parallel"
        ],
        "test": [
            "@analyse",
            "@lint:check",
            "@test:types",
            "@test:unit"
        ],
        "clear": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Knppy\\Ui\\UiServiceProvider"
            ],
            "aliases": {
                "Ui": "Knppy\\Ui\\Facades\\Ui"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
